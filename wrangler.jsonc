{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promed-hub-staging",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promed-hub-staging",
      "database_id": "051946ea-2fe3-4769-8a90-257ec1d7f68c"
    }
  ]
}
